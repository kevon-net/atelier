{
  "name": "@repo/cloudbase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "supabase:init": "supabase init",
    "supabase:telemetry-disable": "supabase telemetry disable",
    "supabase:start": "supabase start -x studio,realtime,storage-api,imgproxy,logflare,vector",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:migration-new": "supabase migration new migration_name",
    "supabase:gen-types": "supabase gen types typescript --local > ../../packages/database/src/types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@repo/config": "workspace:*",
    "supabase": "^2.x.x",
    "typescript": "^5.6.2"
  }
}
