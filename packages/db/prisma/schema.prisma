// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  USER
  ADMIN
  DEV
}

enum SyncStatus {
  PENDING
  SYNCED
  SAVED
  ERROR
  DELETED
}

//
// CORE
//

model User {
  id       String @id @default(cuid())
  userCode String @map("user_code") // more user friendly identification string than cuid

  accounts Account[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userCode])
  @@map("users")
}

model Account {
  id    String @id @default(cuid())
  email String
  role  Role   @default(USER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  sessions   Session[]
  profiles   Profile[]
  workspaces Workspace[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  otp       String?

  // additional data that might change per session, or during a session
  timezone String?

  // allows more than 1 account per session
  accounts Account[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

//
// APP DATA
//

model Profile {
  id         String  @id @default(cuid())
  userName   String? @map("user_name")
  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  phone      String?
  address    String?
  avatar     String?
  customized Boolean @default(false)

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId])
  @@unique([userName])
  @@map("profiles")
}

model Workspace {
  id   String @id @default(cuid())
  name String

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")

  folders Folder[]

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workspaces")
}

//
// APP DATA (Actual)
//

model Folder {
  id       String  @id @default(cuid())
  name     String
  location String
  folderId String? @map("folder_id")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id")

  syncStatus SyncStatus @default(SYNCED) @map("sync_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("folders")
}
