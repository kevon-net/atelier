{
  "name": "repo-root",
  "private": true,
  "scripts": {
    "purge": "find . \\( -name \"node_modules\" -o -name \".turbo\" -o -name \".next\" -o -name \"pnpm-lock.yaml\" -o -name \"package-lock.json\" \\) -exec rm -rf {} +",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate:dev": "pnpm --filter @repo/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/db migrate:deploy",
    "db:push": "pnpm --filter @repo/db push",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:seed": "pnpm --filter @repo/db seed",
    "savour-api:dev": "pnpm --filter savour-api dev",
    "savour-api:build": "pnpm --filter savour-api build",
    "savour-api:start": "pnpm --filter savour-api start",
    "savour-api:lint": "pnpm --filter savour-api lint",
    "savour-api:check-types": "pnpm --filter savour-api check-types",
    "savour-web:dev": "pnpm --filter savour-web dev",
    "savour-web:build": "pnpm --filter savour-web build",
    "savour-web:start": "pnpm --filter savour-web start",
    "savour-web:lint": "pnpm --filter savour-web lint",
    "savour-web:check-types": "pnpm --filter savour-web check-types"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  }
}
