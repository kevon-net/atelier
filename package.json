{
  "name": "repo-root",
  "private": true,
  "scripts": {
    "purge": "find . \\( -name \"node_modules\" -o -name \".turbo\" -o -name \".next\" -o -name \"pnpm-lock.yaml\" -o -name \"package-lock.json\" \\) -exec rm -rf {} +",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "supabase:start": "pnpm --filter @repo/cloudbase supabase:start",
    "supabase:stop": "pnpm --filter @repo/cloudbase supabase:stop",
    "supabase:status": "pnpm --filter @repo/cloudbase supabase:status",
    "supabase:db-reset": "pnpm --filter @repo/cloudbase supabase:db-reset;",
    "supabase:db-push": "pnpm --filter @repo/cloudbase supabase:db-push;",
    "supabase:migration-new": "pnpm --filter @repo/cloudbase supabase:migration-new --",
    "supabase:gen-types": "pnpm --filter @repo/cloudbase supabase:gen-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate-create": "pnpm --filter @repo/db db:migrate-create",
    "db:migrate-dev": "pnpm --filter @repo/db db:migrate-dev",
    "db:migrate-deploy": "pnpm --filter @repo/db db:migrate-deploy",
    "db:migrate-reset": "pnpm --filter @repo/db db:migrate-reset",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "savour:dev": "pnpm --filter savour dev",
    "savour:build": "pnpm --filter savour build",
    "savour:start": "pnpm --filter savour start",
    "savour:lint": "pnpm --filter savour lint",
    "savour:check-types": "pnpm --filter savour check-types",
    "savour:payload-generate-types": "pnpm --filter savour payload:generate-types",
    "savour:payload-generate-importmap": "pnpm --filter savour payload:generate-importmap"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  }
}
