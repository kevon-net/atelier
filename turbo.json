{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "cache": true,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "savour:payload-generate-types": {
      "cache": true
    },
    "savour:payload-generate-importmap": {
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "db:generate",
        "savour:payload-generate-types",
        "savour:payload-generate-importmap"
      ],
      "env": [
        "TURBO_TELEMETRY_DISABLED=1",

        "NODE_ENV",

        "DATABASE_URL",
        "DIRECT_URL",

        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SECRET_KEY",

        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_VERCEL_URL",
        "NEXT_PUBLIC_VERCEL_GIT_COMMIT_REF",

        "NEXT_PUBLIC_EMAIL_DEV",
        "NEXT_PUBLIC_EMAIL_INQUIRIES",
        "NEXT_PUBLIC_EMAIL_NOREPLY",

        "NEXT_PUBLIC_HOST_SAVOUR_DEV",
        "NEXT_PUBLIC_HOST_STOCKWISE_DEV",

        "NEXT_PUBLIC_HOST_SAVOUR_PROD",
        "NEXT_PUBLIC_HOST_STOCKWISE_PROD"
      ],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "savour#db:generate"]
    }
  }
}
